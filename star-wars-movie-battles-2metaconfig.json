[
  {
    "ConfigFile": "{{mod}}/base.cfg",
    "ConfigType": "kvp",
    "ConfigFormat": "{0} \"{1}\"",
    "Subsections": [
      {
        "Heading": "$root",
        "SettingMappings": {
          "//": "MBII AMP Configuration (Controlled by AMP)",
          "//": "Use server.cfg for any additional settings",

          "//": "Server Identification",
          "set sv_hostname": "sv_hostname",
          "set sv_master1": "sv_master1",
          "set sv_master2": "sv_master2",
          "set sv_master3": "sv_master3",
          "set sv_master4": "sv_master4",
          "set sv_master5": "sv_master5",
          "set g_motd": "g_motd",

          "//": "Network & Performance",
          "set sv_allowDownload": "sv_allowDownload",
          "set sv_fps": "sv_fps",
          "set sv_minRate": "sv_minRate",
          "set sv_maxRate": "sv_maxRate",
          "set sv_minSnaps": "sv_minSnaps",
          "set sv_minPing": "sv_minPing",
          "set sv_maxPing": "sv_maxPing",
          "set sv_maxConnections": "sv_maxConnections",
          "set sv_timeout": "sv_timeout",

          "//": "Player Limits",
          "set sv_maxclients": "$MaxUsers",
          "set g_maxGameClients": "g_maxGameClients",
          "set sv_privateClients": "sv_privateClients",

          "//": "Password Protection",
          "set g_needpass": "g_needpass",
          "set g_password": "g_password",
          "set sv_privatePassword": "sv_privatePassword",

          "//": "RCON & SMOD",
          "rconpassword": "$RemoteAdminPassword",
          "set g_smodAdminPassword_1": "g_smodAdminPassword_1",
          "set g_smodConfig_1": "g_smodConfig_1",
          "set g_smodAdminPassword_2": "g_smodAdminPassword_2",
          "set g_smodConfig_2": "g_smodConfig_2",
          "set g_smodAdminPassword_3": "g_smodAdminPassword_3",
          "set g_smodConfig_3": "g_smodConfig_3",
          "set g_smodAdminPassword_4": "g_smodAdminPassword_4",
          "set g_smodConfig_4": "g_smodConfig_4",
          "set g_smodAdminPassword_5": "g_smodAdminPassword_5",
          "set g_smodConfig_5": "g_smodConfig_5",
          "set g_smodAdminPassword_6": "g_smodAdminPassword_6",
          "set g_smodConfig_6": "g_smodConfig_6",
          "set g_smodAdminPassword_7": "g_smodAdminPassword_7",
          "set g_smodConfig_7": "g_smodConfig_7",
          "set g_smodAdminPassword_8": "g_smodAdminPassword_8",
          "set g_smodConfig_8": "g_smodConfig_8",
          "set g_smodAdminPassword_9": "g_smodAdminPassword_9",
          "set g_smodConfig_9": "g_smodConfig_9",
          "set g_smodAdminPassword_10": "g_smodAdminPassword_10",
          "set g_smodConfig_10": "g_smodConfig_10",
          "set g_smodAdminPassword_11": "g_smodAdminPassword_11",
          "set g_smodConfig_11": "g_smodConfig_11",
          "set g_smodAdminPassword_12": "g_smodAdminPassword_12",
          "set g_smodConfig_12": "g_smodConfig_12",
          "set g_smodAdminPassword_13": "g_smodAdminPassword_13",
          "set g_smodConfig_13": "g_smodConfig_13",
          "set g_smodAdminPassword_14": "g_smodAdminPassword_14",
          "set g_smodConfig_14": "g_smodConfig_14",
          "set g_smodAdminPassword_15": "g_smodAdminPassword_15",
          "set g_smodConfig_15": "g_smodConfig_15",
          "set g_smodAdminPassword_16": "g_smodAdminPassword_16",
          "set g_smodConfig_16": "g_smodConfig_16",

          "//": "Voting & Moderation",
          "set g_allowVote": "g_allowVote",
          "set sv_floodProtect": "sv_floodProtect",
          "set g_chatProtectTime": "g_chatProtectTime",
          "set g_filterban": "g_filterban",

          "//": "Inactivity Handling",
          "set g_InactivityKick": "g_InactivityKick",
          "set g_InactivitySpec": "g_InactivitySpec",

          "//": "Spectator Mode",
          "set g_FullSpecTalkToPlayers": "g_FullSpecTalkToPlayers",
          "set g_noSpecMove": "g_noSpecMove",
          "set g_HideHUDFromSpecs": "g_HideHUDFromSpecs",
          "set g_competitive": "g_competitive",

          "//": "NPCs & Bots",
          "set g_allowNPC": "g_allowNPC",
          "set bot_enable": "bot_enable",
          "set bot_minplayers": "bot_minplayers",
          "set bot_nochat": "bot_nochat",

          "//": "Game Mode",
          "set g_gametype": "7",
          "set g_Authenticity": "g_Authenticity",
          "set sv_pure": "sv_pure",
          "set sv_cheats": "sv_cheats",
          "set g_AntiCheat": "g_AntiCheat",

          "//": "MBII Specific",
          "set g_MinMBPoints": "g_MinMBPoints",
          "set g_MBPointsPerRound": "g_MBPointsPerRound",
          "set g_allowedHeroClasses": "g_allowedHeroClasses",
          "set g_allowedVillainClasses": "g_allowedVillainClasses",
          "set g_TimePeriod": "g_TimePeriod",
          "set g_classlimits": "g_classlimits",
          "set g_EUAllowed": "g_EUAllowed",
          "set g_siegeTeam1": "g_siegeTeam1",
          "set g_siegeTeam2": "g_siegeTeam2",
          "set g_dismember": "g_dismember",

          "//": "Team Management",
          "set g_teamAutoJoin": "g_teamAutoJoin",
          "set g_teamForceBalance": "g_teamForceBalance",
          "set g_balance": "g_balance",
          "set g_teamSwap": "g_teamSwap",
          "set g_ShuffleTimer": "g_ShuffleTimer",

          "//": "Match Rules",
          "set fraglimit": "fraglimit",
          "set capturelimit": "capturelimit",
          "set timelimit": "timelimit",
          "set roundlimit": "roundlimit",
          "set g_forcerespawn": "g_forcerespawn",
          "set g_weaponrespawn": "g_weaponrespawn",
          "set g_friendlyFire": "g_friendlyFire",

          "//": "Anti-Teamkill System",
          "set TK_MinorFriendly": "TK_MinorFriendly",
          "set TK_Spec": "TK_Spec",
          "set TK_Kick": "TK_Kick",
          "set TK_ForgiveAfterRounds": "TK_ForgiveAfterRounds",
          "set TK_RemovedPerRound": "TK_RemovedPerRound",
          "set TK_TempBanForRounds": "TK_TempBanForRounds",

          "//": "Advanced",
          "set g_automapcycle": "g_automapcycle",
          "set g_AllowEntity_target_level_change": "g_AllowEntity_target_level_change",

          "//": "Logging",
          "set logfile": "3",
          "set g_log": "g_log",
          "set g_logClientInfo": "g_logClientInfo",
          "set g_logSync": "g_logSync",
          "set g_logExplicit": "g_logExplicit",

          "//": "Custom Config",
          "exec": "server.cfg"
        }
      }
    ]
  }
]
